# Copy this file to .env.local and fill in real values.
# Required for the Contact/Application form (app/api/send-application) to actually send emails.

# The Gmail address that will send the application emails (e.g. info@blucallers.com)
SMTP_USER=

# A Gmail APP PASSWORD for that account — NOT the normal account password.
# Gmail blocks plain-password SMTP logins. Generate one at:
# Google Account -> Security -> 2-Step Verification -> App passwords
SMTP_PASS=

# Where application emails should be delivered. Defaults to SMTP_USER if left blank.
TO_EMAIL=info@blucallers.com
